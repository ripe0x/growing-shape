# Growing Shape web config. Copy to `.env` (or `.env.local`) and edit.
# All vars are read at build time by Vite, so rebuild after changing them.

# --- Local anvil fork (default dev target) ---
VITE_RPC_URL=http://127.0.0.1:8545
VITE_CHAIN_ID=31337
# Local game address comes from deployments/31337.json after ./script/local.sh.
VITE_GAME_ADDRESS=0x98E46E7A6Eb3608461294Ab396AD4A49Ffd83186
VITE_DEPLOY_BLOCK=26305681

# --- Mainnet (production) ---
# VITE_RPC_URL=https://mainnet.gateway.tenderly.co
# VITE_CHAIN_ID=1
# VITE_GAME_ADDRESS=0x...        # set at launch
# VITE_DEPLOY_BLOCK=...          # game deployment block, bounds log scans

# Optional WalletConnect project id. Left blank: WalletConnect is off and only
# injected (browser-extension) wallets are offered. See README.
VITE_WALLETCONNECT_PROJECT_ID=
